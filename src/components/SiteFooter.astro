---
import { DEFAULT_LOCALE, localePath, t, type Locale } from "../i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const links = [
  { href: localePath(locale, "/about"), label: t(locale, "footerAbout") },
  { href: localePath(locale, "/faq"), label: t(locale, "footerFaq") },
  { href: localePath(locale, "/privacy"), label: t(locale, "footerPrivacy") },
];
---

<footer class="site-footer">
  <div class="container">
    <nav class="footer-nav" aria-label={t(locale, "footerNavLabel")}>
      <ul>
        {links.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))}
      </ul>
    </nav>
    <p>{t(locale, "footerDisclaimer")}</p>
    {locale !== DEFAULT_LOCALE && <p>{t(locale, "footerTranslatedNote")}</p>}
  </div>
</footer>
