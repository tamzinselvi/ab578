---
import { DEFAULT_LOCALE, t, type Locale } from "../i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<footer class="site-footer">
  <div class="container">
    <p>{t(locale, "footerDisclaimer")}</p>
    {locale !== DEFAULT_LOCALE && <p>{t(locale, "footerTranslatedNote")}</p>}
  </div>
</footer>
