---
import PlatformPage from "../../components/pages/PlatformPage.astro";
import { platforms } from "../../data/platforms";
import type { PlatformId } from "../../data/types";
import { DEFAULT_LOCALE, localeList, type Locale } from "../../i18n";

export function getStaticPaths() {
  return localeList
    .filter((locale) => locale !== DEFAULT_LOCALE)
    .flatMap((locale) =>
      platforms.map((platform) => ({
        params: { locale, platform: platform.id },
      })),
    );
}

const { locale, platform } = Astro.params as {
  locale: Locale;
  platform: PlatformId;
};
---

<PlatformPage locale={locale} platformId={platform} />
