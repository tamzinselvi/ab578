---
import FilePage from "../../components/pages/FilePage.astro";
import { DEFAULT_LOCALE, localeList, type Locale } from "../../i18n";

export function getStaticPaths() {
  return localeList
    .filter((locale) => locale !== DEFAULT_LOCALE)
    .map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
---

<FilePage locale={locale} />
