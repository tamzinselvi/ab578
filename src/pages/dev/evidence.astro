  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Evidence bundler (dev)</title>
  </head>
  <body>
    <main class="container">
      <h1>Evidence bundler (dev)</h1>
      <EvidenceBundler client:load platform="DoorDash" />
    </main>
    <script>
      import { evidenceDebugHook } from "../../components/evidence/dev-debug";
      // Debug hook for the Playwright caption-rendering check. Dev page only.
      window.__evidenceDebug = evidenceDebugHook;
    </script>
  </body>
</html>
