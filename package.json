{
  "name": "ab578",
  "version": "0.1.0",
  "description": "Static site that helps California residents file food delivery complaints under AB 578",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "postinstall": "astro sync",
    "typecheck": "astro check",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write . && eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check:i18n": "tsx scripts/check-translation-parity.ts",
    "check:emdash": "node scripts/check-em-dash.mjs",
    "check:copy": "npm run check:i18n && npm run check:emdash"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1",
    "preact": "^11.2.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/preact": "^6.1.6",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "astro": "^7.4.12",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
